# Allied Vision USB3 Vision cameras on Linux.
# - gives the logged-in user access (libusb, no root needed)
# - raises the usbfs buffer limit (default 16 MB) so streaming does not drop frames
#
# Install:
#   sudo cp linux/99-vid-recorder.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   then re-plug the camera.

SUBSYSTEM=="usb", ATTR{idVendor}=="1ab2", MODE="0660", TAG+="uaccess"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1ab2", RUN+="/bin/sh -c 'echo 1000 > /sys/module/usbcore/parameters/usbfs_memory_mb'"
